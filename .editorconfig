# EditorConfig: https://editorconfig.org
# Visual Studio 2019+ 및 VS Code에서 지원됨

root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,h,hpp,inl,cs}]
charset = utf-8
indent_style = tab
indent_size = 4

[*.{json,xml,uproject,uplugin}]
charset = utf-8
indent_style = space
indent_size = 4
